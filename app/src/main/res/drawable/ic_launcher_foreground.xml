<?xml version="1.0" encoding="utf-8"?>
<!-- Insets app_logo's play-button mark to sit inside the adaptive-icon safe zone
     (the outer ~33% of a 108x108dp adaptive icon layer can be cropped by the launcher mask). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="18%"
    android:insetTop="18%"
    android:insetRight="18%"
    android:insetBottom="18%">
    <bitmap
        android:src="@drawable/app_logo"
        android:gravity="center" />
</inset>
